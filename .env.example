# Bedrock API key (bearer token) - generate one in the AWS console under
# Amazon Bedrock -> API keys. No AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY needed.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1

# DeepSeek-R1 on Bedrock only supports on-demand invocation through a
# cross-region inference profile - the bare model ID (deepseek.r1-v1:0)
# returns a ValidationException. Verify the exact profile ID for your region
# in the console (Bedrock -> Cross-region inference -> Inference profiles).
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0
