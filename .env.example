# Bedrock API key (bearer token) - generate one in the AWS console under
# Amazon Bedrock -> API keys. No AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY needed.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1

# DeepSeek-R1 is on-demand/serverless on Bedrock (no Marketplace subscription
# needed). Verify the exact model ID for your region in the console (Bedrock
# -> Model access) - some regions only expose it via a cross-region inference
# profile, e.g. us.deepseek.r1-v1:0 instead of the bare ID below.
BEDROCK_MODEL_ID=deepseek.r1-v1:0
